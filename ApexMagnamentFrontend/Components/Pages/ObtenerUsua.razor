@page "/usuarios"
@using ApexMagnamentFrontend.Components.Layout
@using ApexMagnamentFrontend.DTOs
@using ApexMagnamentFrontend.Services
@inject AutheService autheService
@layout MainLayout

<style>
    .custom-shadow {
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        border-radius: 10px;
        padding: 20px;
        background-color: #ffffff;
        transition: transform 0.2s ease-in-out;
        margin-top: 20px;
    }

    .custom-shadow:hover {
        transform: translateY(-3px);
    }

    .table th,
    .table td {
        vertical-align: middle;
    }

    .table thead {
        background-color: #f8f9fa;
    }

    .card-title {
        margin-bottom: 20px;
        font-weight: bold;
    }

    /* Estilos para el modal */
    .modal-background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050; /* Z-index de un modal de Bootstrap */
    }

    .modal-content-custom {
        background-color: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        width: 90%;
        max-width: 600px;
    }
</style>

<h3>Lista de Usuarios</h3>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

@if (cargando)
{
    <p><em>Cargando usuarios...</em></p>
}
else if (usuarios == null || !usuarios.Any())
{
    <p><em>No hay usuarios registrados.</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Teléfono</th>
                <th>Correo Electrónico</th>
                <th>Usuario</th>
                <th>Status</th>
                <th>Fecha de Ingreso</th>
                <th>Fecha de Sesión</th>
                <th>Rol</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in usuarios)
            {
                <tr>
                    <td>@usuario.nombre</td>
                    <td>@usuario.apellido</td>
                    <td>@usuario.telefono</td>
                    <td>@usuario.correo</td>
                    <td>@usuario.user</td>
                    <td>@usuario.status</td>
                    <td>@usuario.fechaIngreso?.ToShortDateString()</td>
                    <td>@usuario.fechaSession?.ToShortDateString()</td>
                    <td>@usuario.rolId</td>
                    <td>
                        <button class="btn btn-outline-dark me-2" @onclick="@(() => EditarUsuario(usuario))">Editar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@* Formulario de Edición en una ventana flotante (Modal) *@
@if (mostrarModal)
{
    <div class="modal-background">
        <div class="modal-content-custom">
            <div class="modal-header">
                <h5 class="modal-title">Editar Usuario</h5>
                <button type="button" class="btn-close" @onclick="CerrarModal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@usuarioEditar" OnValidSubmit="GuardarCambios">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label for="nombre">Nombre</label>
                        <InputText class="form-control" id="nombre" @bind-Value="usuarioEditar.nombre" />
                    </div>
                    <div class="mb-3">
                        <label for="apellido">Apellido</label>
                        <InputText class="form-control" id="apellido" @bind-Value="usuarioEditar.apellido" />
                    </div>
                    <div class="mb-3">
                        <label for="telefono">Teléfono</label>
                        <InputText class="form-control" id="telefono" @bind-Value="usuarioEditar.telefono" />
                    </div>
                    <div class="mb-3">
                        <label for="correo">Correo</label>
                        <InputText class="form-control" id="correo" @bind-Value="usuarioEditar.correo" />
                    </div>

                    <button type="submit" class="btn btn-success">Guardar</button>
                    <button type="button" class="btn btn-secondary ms-2" @onclick="CerrarModal">Cancelar</button>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<GetUsers>? usuarios;
    private string error = string.Empty;
    private bool cargando = true;
    private GetUsers usuarioEditar = new GetUsers();
    private bool mostrarModal = false; // Variable para controlar la visibilidad del modal

    protected override async Task OnInitializedAsync()
    {
        await CargarUsuarios();
    }

    private async Task CargarUsuarios()
    {
        cargando = true;
        StateHasChanged();
        try
        {
            usuarios = await autheService.GetUsuariosAsync();
        }
        catch (Exception ex)
        {
            error = $"❌ Error cargando usuarios: {ex.Message}";
            usuarios = null;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void EditarUsuario(GetUsers usuario)
    {
        // Crea una copia del objeto para evitar modificar la lista original directamente
        usuarioEditar = new GetUsers
        {
            Id = usuario.Id,
            nombre = usuario.nombre,
            apellido = usuario.apellido,
            telefono = usuario.telefono,
            correo = usuario.correo,
            user = usuario.user,
            status = usuario.status,
            fechaIngreso = usuario.fechaIngreso,
            fechaSession = usuario.fechaSession,
            rolId = usuario.rolId
        };
        mostrarModal = true;
        error = string.Empty; // Limpia cualquier error anterior
    }

    private void CerrarModal()
    {
        usuarioEditar = new GetUsers();
        mostrarModal = false;
        error = string.Empty;
    }

    private async Task GuardarCambios()
    {
        var resultado = await autheService.UpdateUsuarioAsync(usuarioEditar);

        if (string.IsNullOrEmpty(resultado))
        {
            await CargarUsuarios();
            CerrarModal();
        }
        else
        {
            error = resultado;
        }
    }
}