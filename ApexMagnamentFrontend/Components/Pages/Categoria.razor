@page "/categorias"
@using ApexMagnamentFrontend.DTOs
@using ApexMagnamentFrontend.Services
@using ApexMagnamentFrontend.Components.Layout
@inject CategoriaService CategoriaService
@inject AutheService AuthService
@inject NavigationManager Navigation

@inject IJSRuntime JS

@layout MainLayout

<PageTitle>Gestión de Categorías</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Gestión de Categorías</h1>
                @if (estaAutenticado)
                {
                    <button class="btn btn-primary" @onclick="AbrirModalCrear">
                        <i class="bi bi-plus-circle"></i> Nueva Categoría
                    </button>
                }
            </div>

            @if (!estaAutenticado)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    Debe iniciar sesión para gestionar las categorías.
                </div>
            }

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Lista de Categorías</h5>
                </div>
                <div class="card-body">
                    @if (cargando)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-2">Cargando categorías...</p>
                        </div>
                    }
                    else if (categorias != null && categorias.Count == 0)
                    {
                        <div class="text-center text-muted">
                            <i class="bi bi-x-circle" style="font-size: 3rem;"></i>
                            <p class="mt-2">No hay categorías registradas</p>
                        </div>
                    }
                    else if (categorias != null)
                    {
                        <div class="row row-cols-1 row-cols-md-3 g-4">
                            @foreach (var categoria in categorias)
                            {                               
                                <div class="card-body text-center">
                                    <div class="d-flex justify-content-center mb-3">
                                        <span class="rounded-circle bg-dark d-flex align-items-center justify-content-center"
                                              style="width: 60px; height: 60px;">
                                            <i class="bi bi-layers text-white" style="font-size: 1.5rem;"></i>
                                        </span>
                                    </div>
                                    <h5 class="card-title mt-3">@categoria.NombreCategoria</h5>
                                    <p class="text-muted">ID: @categoria.Id</p>

                                    @if (estaAutenticado)
                                    {
                                        <button class="btn btn-sm btn-warning me-2" @onclick="() => AbrirModalEditar(categoria)">
                                            <i class="bi bi-pencil"></i> Editar
                                        </button>

                                        <button class="btn btn-sm btn-danger" @onclick="() => AbrirModalEliminar(categoria)">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </button>

                                    }
                                </div>

                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger">
                            <strong>Error:</strong> No se pudieron cargar las categorías.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editando ? "Editar Categoría" : "Nueva Categoría")</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre de la Categoría</label>
                        <input type="text" class="form-control" @bind="categoriaFormulario.NombreCategoria" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button class="btn btn-primary" @onclick="GuardarCategoria">
                        @(editando ? "Guardar Cambios" : "Crear")
                    </button>
                </div>
            </div>
        </div>
    </div>
}
@if (mostrarModalEliminar)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModalEliminar"></button>
                </div>
                <div class="modal-body text-center">
                    <i class="bi bi-exclamation-triangle text-warning" style="font-size: 3rem;"></i>
                    <p class="mt-3">¿Está seguro que desea eliminar la categoría <strong>@nombreCategoriaAEliminar</strong>?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModalEliminar">Cancelar</button>
                    <button class="btn btn-danger" @onclick="ConfirmarEliminar">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}



@code {
    private List<Categorias>? categorias;
    private CrearCategoria categoriaFormulario = new();

    private bool editando = false;
    private int categoriaIdSeleccionada;


    private bool mostrarModal = false;
    private bool cargando = true;
    private bool estaAutenticado = false;

    private bool mostrarModalEliminar = false;
    private int categoriaIdAEliminar;
    private string? nombreCategoriaAEliminar;

    protected override async Task OnInitializedAsync()
    {
        await VerificarAutenticacion();
        await CargarCategorias();
    }

    private async Task VerificarAutenticacion()
    {
        estaAutenticado = await AuthService.IsAuthenticated();
        StateHasChanged();
    }

    private async Task CargarCategorias()
    {
        cargando = true;
        StateHasChanged();

        try
        {
            categorias = await CategoriaService.ObtenerCategoriasAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar categorías: {ex.Message}");
            categorias = null;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void AbrirModalCrear()
    {
        categoriaFormulario = new CrearCategoria();
        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        categoriaFormulario = new CrearCategoria();
        editando = false;
    }

    private void AbrirModalEditar(Categorias categoria)
    {
        categoriaIdSeleccionada = categoria.Id;
        categoriaFormulario = new CrearCategoria
            {
                NombreCategoria = categoria.NombreCategoria
            };
        editando = true;
        mostrarModal = true;
    }


    private async Task GuardarCategoria()
    {
        Console.WriteLine($"Guardando categoria, editando={editando}, Id={categoriaIdSeleccionada}");

        if (!estaAutenticado)
            return;

        bool resultado;
        try
        {
            if (editando)
            {
                resultado = await CategoriaService.ActualizarCategoriaAsync(categoriaIdSeleccionada, categoriaFormulario);
            }
            else
            {
                resultado = await CategoriaService.CrearCategoriaAsync(categoriaFormulario);
            }

            if (resultado)
            {
                CerrarModal();
                await CargarCategorias();
            }
            else
            {
                Console.WriteLine("No se pudo guardar la categoría");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al guardar categoría: {ex.Message}");
        }
    }

    private void AbrirModalEliminar(Categorias categoria)
    {
        categoriaIdAEliminar = categoria.Id;
        nombreCategoriaAEliminar = categoria.NombreCategoria;
        mostrarModalEliminar = true;
    }

    private void CerrarModalEliminar()
    {
        mostrarModalEliminar = false;
        categoriaIdAEliminar = 0;
        nombreCategoriaAEliminar = null;
    }

    private async Task ConfirmarEliminar()
    {
        bool resultado = await CategoriaService.EliminarCategoriaAsync(categoriaIdAEliminar);
        if (resultado)
        {
            await CargarCategorias();
        }
        else
        {
            Console.WriteLine("No se pudo eliminar la categoría");
        }

        CerrarModalEliminar();
    }



}