@page "/createUser"
@using ApexMagnamentFrontend.DTOs
@using ApexMagnamentFrontend.Services

@inject NavigationManager navigationManager
@inject AutheService authService

@code {
    private CreateUser createUsser = new CreateUser();
    private string errorMessage;
    private bool isLoading = true;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Verificar autenticación después del primer render
            if (!await authService.IsAuthenticated())
            {
                navigationManager.NavigateTo("/");
                return;
            }
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CrearUsuario()
    {
        try
        {
            errorMessage = null;
            var error = await authService.CrearUsuario(createUsser);

            if (error == null)
            {
                navigationManager.NavigateTo("/weather");
            }
            else
            {
                errorMessage = error;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al crear usuario: {ex.Message}";
        }
    }
}

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-center align-items-center">
        <div class="card shadow-lg p-4 login-card w-75">
            <div class="login-form-section">
                <div class="login-image-section text-center mb-4">
                    <img src="/img/Logo.jpeg" class="img-fluid" style="max-width: 150px;">
                </div>
                <h2 class="text-center mb-4">Bienvenido</h2>
                <EditForm Model="createUsser" OnValidSubmit="CrearUsuario">
                    <div class="mb-3">
                        <label for="nombreInput" class="form-label">Nombre</label>
                        <InputText class="form-control" @bind-Value="createUsser.nombre" required />
                    </div>
                    <div class="mb-3">
                        <label for="apellidoInput" class="form-label">Apellido</label>
                        <InputText class="form-control" @bind-Value="createUsser.apellido" placeholder="Ingresa su apellido" required />
                    </div>
                    <div class="mb-3">
                        <label for="telefonoInput" class="form-label">Telefono</label>
                        <InputText class="form-control" @bind-Value="createUsser.telefono" placeholder="Ingresa su Telefono" required />
                    </div>
                    <div class="mb-3">
                        <label for="correoInput" class="form-label">Correo</label>
                        <InputText class="form-control" @bind-Value="createUsser.correo" placeholder="Ingresa su correo" required />
                    </div>
                    <div class="mb-3">
                        <label for="usuarioInput" class="form-label">Usuario</label>
                        <InputText class="form-control" @bind-Value="createUsser.user" placeholder="Ingresa su usuario" required />
                    </div>
                    <div class="mb-3">
                        <label for="passwordInput" class="form-label">Contraseña</label>
                        <InputText type="password" class="form-control" @bind-Value="createUsser.password" placeholder="Ingresa su contraseña" required />
                    </div>
                    <div class="mb-3">
                        <label for="statusInput" class="form-label">Status</label>
                        <InputNumber class="form-control" @bind-Value="createUsser.status" placeholder="status" required />
                    </div>
                    <div class="mb-3">
                        <label for="fechaIngresoInput" class="form-label">Fecha ingreso</label>
                        <InputDate class="form-control"
                                   @bind-Value="createUsser.fechaIngreso"
                                   required />
                    </div>
                    <div class="mb-3">
                        <label for="fechassionInput" class="form-label">Fecha Session</label>
                        <InputDate class="form-control"
                                   @bind-Value="createUsser.fechaSession"
                                   required />
                    </div>
                    <div class="mb-3">
                        <label for="rolInput" class="form-label">Rol</label>
                        <InputNumber class="form-control" @bind-Value="createUsser.rolId" placeholder="Rol" required />
                    </div>
                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="buttonstyleCrearUsuario">Entrar</button>
                    </div>
                </EditForm>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">@errorMessage</div>
                }
            </div>
        </div>
    </div>
}