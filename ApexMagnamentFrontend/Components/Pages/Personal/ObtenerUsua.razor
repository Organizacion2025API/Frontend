@page "/usuarios"
@using ApexMagnamentFrontend.Components.Layout
@using ApexMagnamentFrontend.DTOs
@using ApexMagnamentFrontend.Services
@inject AutheService autheService
@inject NavigationManager NavigationManager
@layout MainLayout

<style>
    /* Estilos generales para el contenedor principal */
    .container-fluid {
        padding: 2rem;
    }

    /* Estilo del card principal que contiene los filtros y la tabla */
    .card {
        border-radius: 0.75rem;
        border: none;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
    }

    .card-header {
        border-top-left-radius: 0.75rem;
        border-top-right-radius: 0.75rem;
        background-color: #f8f9fa;
        border-bottom: 1px solid #e9ecef;
    }

    /* Estilos para el filtro de búsqueda */
    .input-group-text {
        background-color: #e9ecef;
        border: 1px solid #ced4da;
        border-right: none;
    }

    .form-control {
        border-left: none;
    }

    /* Estilos de la tabla */
    .table-responsive {
        overflow-x: auto;
    }

    .table {
        margin-bottom: 0;
    }

        .table thead th {
            background-color: #343a40; /* Color de fondo oscuro para el encabezado */
            color: white; /* Texto blanco para el encabezado */
            font-weight: 600;
            vertical-align: middle;
            border-bottom: none; /* Eliminar el borde inferior del encabezado */
        }

        .table tbody tr {
            transition: background-color 0.2s ease;
        }

            .table tbody tr:hover {
                background-color: #f1f1f1; /* Color de fondo al pasar el mouse */
            }

        .table td, .table th {
            vertical-align: middle;
        }

    /* Estilos para el estado del usuario */
    .badge-status {
        font-size: 0.85em;
        font-weight: 600;
        padding: 0.4em 0.8em;
        border-radius: 1rem;
    }

    .badge-active {
        background-color: #28a745; /* Verde */
        color: white;
    }

    .badge-inactive {
        background-color: #dc3545; /* Rojo */
        color: white;
    }

    /* Estilos de botones */
    .btn-outline-dark,
    .btn-success {
        border-radius: 50px;
        padding: 0.5rem 1.5rem;
        font-weight: 600;
        transition: all 0.2s ease-in-out;
    }

        .btn-outline-dark:hover {
            background-color: #343a40;
            color: white;
        }

    /* Estilos para el modal, mejorando el diseño del modal */
    .modal-content-custom {
        border-radius: 1rem;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
    }

    .modal-header {
        border-bottom: none;
    }

    .modal-footer {
        border-top: none;
    }

    .table th, .table td {
        white-space: nowrap; /* Evita que el texto de las celdas se parta en varias líneas */
    }

        /* Ajusta el ancho de columnas específicas */
        .table th:nth-child(2), .table td:nth-child(2) {
            width: 80px; /* Ancho para ID */
        }

        .table th:nth-child(9), .table td:nth-child(9) {
            width: 120px; /* Ancho para Fecha de Ingreso */
        }

        .table th:nth-child(10), .table td:nth-child(10) {
            width: 120px; /* Ancho para Fecha de Sesión */
        }

    /* Estilos para el modal */
    .modal-background {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1050; /* Esto asegura que el modal esté por encima de todo */
    }

    .modal-content-custom {
        background-color: white;
        padding: 20px;
        border-radius: 1rem;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
        width: 90%;
        max-width: 600px;
    }

    .modal-header {
        border-bottom: none;
    }

    .modal-footer {
        border-top: none;
    }

</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Gestión de Usuarios</h1>
                <div class="d-flex align-items-center">
                    <div class="col-sm-auto me-3">
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text"
                                   class="form-control"
                                   @bind="filtroBusqueda"
                                   @bind:event="oninput"
                                   placeholder="Buscar ID o nombre..." />
                        </div>
                    </div>
                    <button class="btn btn-success" @onclick="IrACrear">
                        <i class="bi bi-person-plus-fill"></i> Nuevo Personal
                    </button>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Lista de Personal</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="alert alert-danger" role="alert">
                            @error
                        </div>
                    }

                    @if (cargando)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-2">Cargando usuarios...</p>
                        </div>
                    }
                    else if (usuariosFiltrados == null || !usuariosFiltrados.Any())
                    {
                        <div class="text-center text-muted">
                            <i class="bi bi-people" style="font-size: 3rem;"></i>
                            <p class="mt-2">No se encontraron usuarios que coincidan con la búsqueda.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Nombre</th>
                                        <th>Apellido</th>
                                        <th>Teléfono</th>
                                        <th>Correo Electrónico</th>
                                        <th>Usuario</th>
                                        <th>Rol</th>
                                        <th>Status</th>
                                        <th>Fecha de Ingreso</th>
                                        <th>Última Sesión</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var usuario in usuariosFiltrados)
                                    {
                                        <tr>
                                            <td>@usuario.id</td>
                                            <td>@usuario.nombre</td>
                                            <td>@usuario.apellido</td>
                                            <td>@usuario.telefono</td>
                                            <td>@usuario.correo</td>
                                            <td>@usuario.user</td>
                                            <td>@usuario.rolId</td>
                                            <td>
                                                <span class="badge badge-status @(usuario.status == 1 ? "badge-active" : "badge-inactive")">
                                                    @(usuario.status == 1 ? "Activo" : "Inactivo")
                                                </span>
                                            </td>
                                            <td>@usuario.fechaIngreso?.ToShortDateString()</td>
                                            <td>@usuario.fechaSession?.ToShortDateString()</td>
                                            <td>
                                                <button class="btn btn-sm btn-info" @onclick="@(() => EditarUsuario(usuario))">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* Formulario de Edición en una ventana flotante (Modal) *@
@if (mostrarModal)
{
    <div class="modal-background">
        <div class="modal-content-custom">
            <div class="modal-header">
                <h5 class="modal-title">Editar Usuario</h5>
                <button type="button" class="btn-close" @onclick="CerrarModal"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@usuarioEditar" OnValidSubmit="GuardarCambios">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label for="nombre">Nombre</label>
                        <InputText class="form-control" id="nombre" @bind-Value="usuarioEditar.nombre" />
                    </div>
                    <div class="mb-3">
                        <label for="apellido">Apellido</label>
                        <InputText class="form-control" id="apellido" @bind-Value="usuarioEditar.apellido" />
                    </div>
                    <div class="mb-3">
                        <label for="telefono">Teléfono</label>
                        <InputText class="form-control" id="telefono" @bind-Value="usuarioEditar.telefono" />
                    </div>
                    <div class="mb-3">
                        <label for="correo">Correo</label>
                        <InputText class="form-control" id="correo" @bind-Value="usuarioEditar.correo" />
                    </div>
                    <div class="mb-3">
                        <label for="usuario">Usuario</label>
                        <InputText class="form-control" id="user" @bind-Value="usuarioEditar.user" />
                    </div>

                    <button type="submit" class="btn btn-success">Guardar Cambios</button>
                    <button type="button" class="btn btn-secondary ms-2" @onclick="CerrarModal">Cancelar</button>
                    <button type="button" class="btn btn-danger ms-2" @onclick="@(() => EliminarUsuario(usuarioEditar.id))">Eliminar</button>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<GetUsers>? usuarios;
    private List<GetUsers>? usuariosFiltrados;
    private string error = string.Empty;
    private bool cargando = true;
    private GetUsers usuarioEditar = new GetUsers();
    private bool mostrarModal = false;
    private string _filtroBusqueda = string.Empty;

    // Propiedad que se encarga de la lógica de filtrado cuando cambia el valor
    private string filtroBusqueda
    {
        get => _filtroBusqueda;
        set
        {
            _filtroBusqueda = value;
            FiltrarUsuarios();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarUsuarios();
        }
    }

    private void FiltrarUsuarios()
    {
        if (usuarios == null)
        {
            usuariosFiltrados = new List<GetUsers>();
            return;
        }

        if (string.IsNullOrWhiteSpace(_filtroBusqueda))
        {
            usuariosFiltrados = usuarios;
        }
        else
        {
            if (int.TryParse(_filtroBusqueda, out int idBusqueda))
            {
                usuariosFiltrados = usuarios.Where(u => u.id == idBusqueda).ToList();
            }
            else
            {
                usuariosFiltrados = usuarios.Where(u =>
                    (u.nombre != null && u.nombre.Contains(_filtroBusqueda, StringComparison.OrdinalIgnoreCase)) ||
                    (u.apellido != null && u.apellido.Contains(_filtroBusqueda, StringComparison.OrdinalIgnoreCase))
                ).ToList();
            }
        }
    }

    private async Task CargarUsuarios()
    {
        cargando = true;
        StateHasChanged();
        try
        {
            usuarios = await autheService.GetUsuariosAsync();
            FiltrarUsuarios(); // Llama a la función de filtro inicial
        }
        catch (Exception ex)
        {
            error = $"❌ Error cargando usuarios: {ex.Message}";
            usuarios = null;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void EditarUsuario(GetUsers usuario)
    {
        usuarioEditar = new GetUsers
        {
            id = usuario.id,
            nombre = usuario.nombre,
            apellido = usuario.apellido,
            telefono = usuario.telefono,
            correo = usuario.correo,
            user = usuario.user,
            status = usuario.status,
            fechaIngreso = usuario.fechaIngreso,
            fechaSession = usuario.fechaSession,
            rolId = usuario.rolId
        };
        mostrarModal = true;
        error = string.Empty;
    }

    private void CerrarModal()
    {
        usuarioEditar = new GetUsers();
        mostrarModal = false;
        error = string.Empty;
        StateHasChanged();
    }

    private async Task GuardarCambios()
    {
        var resultado = await autheService.UpdateUsuarioAsync(usuarioEditar);

        if (string.IsNullOrEmpty(resultado))
        {
            await CargarUsuarios();
            CerrarModal();
        }
        else
        {
            error = resultado;
        }
    }
    // Método para redirigir a la página de eliminación
    private void EliminarUsuario(int id)
    {
        CerrarModal(); // Cierra el modal antes de la redirección
        NavigationManager.NavigateTo($"/EliminarUsu/{id}");
    }

    void IrACrear() => NavigationManager.NavigateTo("/createUser");
}