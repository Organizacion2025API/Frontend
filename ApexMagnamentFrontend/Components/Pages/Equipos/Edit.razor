@page "/equipos/edit/{id:int}"
@using ApexMagnamentFrontend.DTOs
@using ApexMagnamentFrontend.Services
@inject EquipoService EquipoService
@inject CategoriaService CategoriaService
@inject UbicacionService UbicacionService
@inject NavigationManager NavigationManager

<h3 class="text-center mb-4">✏️ Editar Equipo</h3>

@if (equipo == null)
{
    <p>⏳ Cargando equipo...</p>
}
else
{
    <div class="d-flex justify-content-center">
        <div class="card shadow-lg p-4 mb-5 bg-white rounded" style="width: 500px;">
            <div class="card-body">
                <EditForm Model="equipo" OnValidSubmit="Guardar">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label>Nombre</label>
                        <InputText class="form-control" @bind-Value="equipo.Nombre" />
                    </div>

                    <div class="mb-3">
                        <label>Modelo</label>
                        <InputText class="form-control" @bind-Value="equipo.Modelo" />
                    </div>

                    <div class="mb-3">
                        <label>N° Serie</label>
                        <InputText class="form-control" @bind-Value="equipo.NSerie" />
                    </div>

                    <div class="mb-3">
                        <label>Descripción</label>
                        <InputText class="form-control" @bind-Value="equipo.Descripcion" />
                    </div>

                    <div class="mb-3">
                        <label>Garantía (meses)</label>
                        <InputNumber class="form-control" @bind-Value="equipo.Garantia" />
                    </div>

                    <div class="mb-3">
                        <label>Imagen (URL)</label>
                        <InputText class="form-control" @bind-Value="equipo.Img" />
                    </div>

                    <div class="mb-3">
                        <label>Categoría</label>
                        <InputSelect class="form-select" @bind-Value="equipo.CategoriaId">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var cat in categorias)
                            {
                                <option value="@cat.Id">@cat.NombreCategoria</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="mb-3">
                        <label>Ubicación</label>
                        <InputSelect class="form-select" @bind-Value="equipo.UbicacionId">
                            <option value="">-- Seleccionar --</option>
                            @foreach (var ubi in ubicaciones)
                            {
                                <option value="@ubi.Id">@ubi.NombreUbicacion</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="d-flex justify-content-between">
                        <button type="submit" class="btn btn-outline-success">💾 Guardar</button>
                        <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">❌ Cancelar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int id { get; set; }
    private EditarEquipoDTO equipo = new EditarEquipoDTO();
    private List<Categorias> categorias = new();
    private List<UbicacionDTO> ubicaciones = new();

    protected override async Task OnInitializedAsync()
    {
        categorias = await CategoriaService.ObtenerCategoriasAsync();
        ubicaciones = await UbicacionService.GetAllAsync();

        var lista = await EquipoService.GetAllAsync();
        var encontrado = lista.FirstOrDefault(e => e.Id == id);
        if (encontrado != null)
        {
            equipo = new EditarEquipoDTO
            {
                Id = encontrado.Id,
                Nombre = encontrado.Nombre,
                Modelo = encontrado.Modelo,
                NSerie = encontrado.NSerie,
                Descripcion = encontrado.Descripcion,
                Garantia = encontrado.Garantia,
                Img = encontrado.Img,
                CategoriaId = encontrado.CategoriaId ?? 0,
                UbicacionId = encontrado.UbicacionId ?? 0
            };
        }
    }

    private async Task Guardar()
    {
        var ok = await EquipoService.UpdateAsync(equipo.Id, equipo);
        if (ok)
        {
            Console.WriteLine("✅ Equipo editado correctamente.");
            NavigationManager.NavigateTo("/equipos");
        }
        else
        {
            Console.WriteLine("❌ Error al editar equipo.");
        }
    }

    void Cancelar() => NavigationManager.NavigateTo("/equipos");
}
