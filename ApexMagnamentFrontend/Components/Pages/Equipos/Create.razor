@page "/equipos/create"
@using ApexMagnamentFrontend.DTOs
@using ApexMagnamentFrontend.Services
@inject EquipoService EquipoService
@inject CategoriaService CategoriaService
@inject UbicacionService UbicacionService
@inject NavigationManager NavigationManager

<h3 class="text-center mb-4">➕ Crear Equipo</h3>

<div class="d-flex justify-content-center">
    <div class="card shadow-lg p-4 mb-5 bg-white rounded" style="width: 500px;">
        <div class="card-body">
            <EditForm Model="nuevo" OnValidSubmit="Guardar">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label>Nombre</label>
                    <InputText class="form-control" @bind-Value="nuevo.Nombre" />
                </div>

                <div class="mb-3">
                    <label>Modelo</label>
                    <InputText class="form-control" @bind-Value="nuevo.Modelo" />
                </div>

                <div class="mb-3">
                    <label>N° Serie</label>
                    <InputText class="form-control" @bind-Value="nuevo.NSerie" />
                </div>

                <div class="mb-3">
                    <label>Descripción</label>
                    <InputText class="form-control" @bind-Value="nuevo.Descripcion" />
                </div>

                <div class="mb-3">
                    <label>Garantía (meses)</label>
                    <InputNumber class="form-control" @bind-Value="nuevo.Garantia" />
                </div>

                <div class="mb-3">
                    <label>Imagen (URL)</label>
                    <InputText class="form-control" @bind-Value="nuevo.Img" />
                </div>

                <div class="mb-3">
                    <label>Categoría</label>
                    <InputSelect class="form-select" @bind-Value="nuevo.CategoriaId">
                        <option value="0">-- Seleccionar --</option>
                        @foreach (var cat in categorias)
                        {
                            <option value="@cat.Id">@cat.NombreCategoria</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label>Ubicación</label>
                    <InputSelect class="form-select" @bind-Value="nuevo.UbicacionId">
                        <option value="0">-- Seleccionar --</option>
                        @foreach (var ubi in ubicaciones)
                        {
                            <option value="@ubi.Id">@ubi.NombreUbicacion</option>
                        }
                    </InputSelect>
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-outline-success">✅ Guardar</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="Cancelar">❌ Cancelar</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private CrearEquipoDTO nuevo = new CrearEquipoDTO();
    private List<Categorias> categorias = new();
    private List<UbicacionDTO> ubicaciones = new();

    protected override async Task OnInitializedAsync()
    {
        categorias = await CategoriaService.ObtenerCategoriasAsync();
        ubicaciones = await UbicacionService.GetAllAsync();
    }

    private async Task Guardar()
    {
        Console.WriteLine("👉 Se ejecutó el método Guardar()");

        var ok = await EquipoService.CreateAsync(nuevo);
        if (ok)
        {
            Console.WriteLine("✅ Equipo creado correctamente.");
            NavigationManager.NavigateTo("/equipos");
        }
        else
        {
            Console.WriteLine("❌ Error al crear equipo.");
        }
    }

    private void Cancelar() => NavigationManager.NavigateTo("/equipos");
}
