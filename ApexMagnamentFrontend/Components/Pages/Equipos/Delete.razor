@page "/equipos/delete/{id:int}"
@using ApexMagnamentFrontend.DTOs
@using ApexMagnamentFrontend.Services
@inject EquipoService EquipoService
@inject NavigationManager NavigationManager

<h3 class="text-center mb-4">🗑️ Eliminar Equipo</h3>

@if (equipo == null)
{
    <p>⏳ Cargando equipo...</p>
}
else
{
    <div class="d-flex justify-content-center">
        <div class="card shadow-lg p-4 mb-5 bg-white rounded" style="width: 450px;">
            <div class="card-body">
                <h5 class="card-title text-danger">¿Seguro que deseas eliminar este equipo?</h5>

                <div class="mb-3">
                    <label>Nombre</label>
                    <p class="form-control">@equipo.Nombre</p>
                </div>

                <div class="mb-3">
                    <label>Modelo</label>
                    <p class="form-control">@equipo.Modelo</p>
                </div>

                <div class="mb-3">
                    <label>N° Serie</label>
                    <p class="form-control">@equipo.NSerie</p>
                </div>

                <div class="mb-3">
                    <label>Descripción</label>
                    <p class="form-control">@equipo.Descripcion</p>
                </div>

                <div class="mb-3">
                    <label>Garantía (meses)</label>
                    <p class="form-control">@equipo.Garantia</p>
                </div>

                <div class="mb-3">
                    <label>Imagen (URL)</label>
                    <p class="form-control">@equipo.Img</p>
                </div>

                <div class="mb-3">
                    <label>Categoría</label>
                    <p class="form-control">@equipo.CategoriaId</p>
                </div>

                <div class="mb-3">
                    <label>Ubicación</label>
                    <p class="form-control">@equipo.UbicacionId</p>
                </div>

                <div class="d-flex justify-content-between">
                    <button class="btn btn-outline-danger" @onclick="Confirmar">Sí, eliminar</button>
                    <button class="btn btn-outline-secondary" @onclick="Cancelar">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int id { get; set; }
    private EquipoDTO equipo;

    protected override async Task OnInitializedAsync()
    {
        var lista = await EquipoService.GetAllAsync();
        equipo = lista.FirstOrDefault(e => e.Id == id);
    }

    private async Task Confirmar()
    {
        var ok = await EquipoService.DeleteAsync(id);
        if (ok)
        {
            Console.WriteLine("✅ Equipo eliminado correctamente.");
        }
        else
        {
            Console.WriteLine("❌ Error al eliminar equipo.");
        }
        NavigationManager.NavigateTo("/equipos");
    }

    void Cancelar() => NavigationManager.NavigateTo("/equipos");
}
