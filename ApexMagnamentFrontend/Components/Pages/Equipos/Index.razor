@page "/equipos"
@using ApexMagnamentFrontend.DTOs
@using ApexMagnamentFrontend.Services
@inject NavigationManager NavigationManager   
@inject EquipoService EquipoService
@using ApexMagnamentFrontend.Components.Layout
@layout MainLayout

<h3 class="text-center mb-4">📋 Lista de Equipos</h3>

<div class="d-flex justify-content-center">
    <div class="card shadow-lg p-4 mb-5 bg-white rounded" style="width: 90%; max-width: 1000px;">
        <div class="card-body">
            <button class="btn btn-outline-dark mb-3" @onclick="IrACrear">➕ Nuevo Equipo</button>

            @if (equipos == null)
            {
                <p>⏳ Cargando equipos...</p>
            }
            else if (!equipos.Any())
            {
                <p>No hay equipos registrados.</p>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Modelo</th>
                                <th>N° Serie</th>
                                <th>Categoría</th>
                                <th>Ubicación</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var eq in equipos)
                        {
                            <tr>
                                <td>@eq.Nombre</td>
                                <td>@eq.Modelo</td>
                                <td>@eq.NSerie</td>
                                <td>@eq.CategoriaId</td>
                                <td>@eq.UbicacionId</td>
                                <td>
                                    <button class="btn btn-outline-dark mb-3" @onclick="() => IrAEditar(eq.Id)">✏️ Editar</button>
                                    <button class="btn btn-outline-dark mb-3" @onclick="() => IrAEliminar(eq.Id)">🗑️ Eliminar</button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<EquipoDTO>? equipos;

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("📡 Cargando equipos...");
        equipos = await EquipoService.GetAllAsync();
        Console.WriteLine($"✅ Se cargaron {equipos.Count} equipos.");
    }

    void IrACrear() => NavigationManager.NavigateTo("/equipos/create");
    void IrAEditar(int id) => NavigationManager.NavigateTo($"/equipos/edit/{id}");
    void IrAEliminar(int id) => NavigationManager.NavigateTo($"/equipos/delete/{id}");
}
