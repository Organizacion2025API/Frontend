@page "/solicitudes"
@using ApexMagnamentFrontend.DTOs
@using ApexMagnamentFrontend.Services
@using ApexMagnamentFrontend.Components.Layout
@inject SolicitudService SolicitudService
@inject AutheService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS

@layout MainLayout

<PageTitle>Lista de Solicitudes</PageTitle>

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Solicitudes de Mantenimiento</h1>                                
            </div>

            @if (!estaAutenticado)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    Debe iniciar sesión para ver las solicitudes.
                </div>
            }

            <div class="card mb-4">
                <div class="card-body">
                    <div class="row">
                        @* 💡 FILTRO POR ID (Lado Izquierdo) *@
                        <div class="col-md-6 mb-3 mb-md-0">
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-hash"></i></span>
                                <input type="number"
                                       class="form-control"
                                       placeholder="Buscar por ID de la solicitud..."
                                       @bind="filtroBusquedaId"
                                       @bind:event="oninput" />
                            </div>
                        </div>

                        @* 💡 FILTRO POR Estado (Lado Derecho) *@
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-gear"></i></span>
                                <input type="number"
                                       class="form-control"
                                       placeholder="Buscar por Estado (ej: 1, 2, 3)..."
                                       @bind="filtroBusquedaEstado"
                                       @bind:event="oninput" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Lista de Solicitudes</h5>
                </div>
                <div class="card-body">
                    @if (cargando)
                    {
                        <div class="text-center">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-2">Cargando solicitudes...</p>
                        </div>
                    }
                    else
                    {
                        @if (solicitudes == null)
                        {
                            <div class="alert alert-danger">
                                <strong>Error:</strong> No se pudieron cargar las solicitudes.
                            </div>
                        }
                        else if (!SolicitudesFiltradas.Any())
                        {
                            <div class="text-center text-muted">
                                <i class="bi bi-file-earmark-text" style="font-size: 3rem;"></i>
                                <p class="mt-2">No se encontraron solicitudes que coincidan con los filtros.</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>ID</th>
                                            <th>Descripción</th>
                                            <th>Estado</th>
                                            <th>Fecha Registro</th>
                                            <th>ID Equipo</th>
                                            <th>ID Personal</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @* Recorremos SolicitudesFiltradas *@
                                        @foreach (var solicitud in SolicitudesFiltradas)
                                        {
                                            <tr>
                                                <td>@solicitud.Id</td>
                                                <td>@solicitud.Descripcion</td>
                                                <td>
                                                    <span class="badge @(solicitud.Estado == 3 ? "bg-success" : solicitud.Estado == 2 ? "bg-warning text-dark" : "bg-primary")">
                                                        @GetEstadoTexto(solicitud.Estado)
                                                    </span>
                                                </td>
                                                <td>@solicitud.FechaRegistro?.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>@solicitud.AsignacionEquipoId</td>
                                                <td>@solicitud.PersonalId</td>
                                                <td>
                                                    <button class="btn btn-sm btn-info" @onclick="() => VerDetalle(solicitud)">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<SolicitudDTO.Solicitud>? solicitudes;
    private bool cargando = true;
    private bool estaAutenticado = false;

    private string filtroBusquedaId = string.Empty;
    private string filtroBusquedaEstado = string.Empty;

    // Propiedad calculada para aplicar filtros
    private IEnumerable<SolicitudDTO.Solicitud> SolicitudesFiltradas
    {
        get
        {
            var consulta = solicitudes ?? Enumerable.Empty<SolicitudDTO.Solicitud>();

            // Filtro 1: Por ID (Búsqueda parcial en el ID)
            if (!string.IsNullOrWhiteSpace(filtroBusquedaId))
            {
                consulta = consulta.Where(r => r.Id.ToString().Contains(filtroBusquedaId));
            }

            // Filtro 2: Por Estado (Búsqueda exacta por número - Lógica solicitada)
            if (!string.IsNullOrWhiteSpace(filtroBusquedaEstado))
            {
                // Intentamos parsear el filtro como un short
                if (short.TryParse(filtroBusquedaEstado, out short estadoFiltro))
                {
                    // Aplicamos la coincidencia exacta
                    consulta = consulta.Where(r => r.Estado == estadoFiltro);
                }
                else
                {
                    // Si no es un número válido, recurrimos a buscar el texto contenido
                    consulta = consulta.Where(r => r.Estado.ToString().Contains(filtroBusquedaEstado));
                }
            }

            return consulta;
        }
    }

    // Helper para mostrar el estado como texto
    private string GetEstadoTexto(int estado)
    {
        return estado switch
        {
            1 => "Pendiente",
            2 => "Iniciado",
            3 => "Finalizado",
            _ => "Desconocido"
        };
    }

    protected override async Task OnInitializedAsync()
    {
        await VerificarAutenticacion();
        await CargarSolicitudes();
    }

    private async Task VerificarAutenticacion()
    {
        estaAutenticado = await AuthService.IsAuthenticated();
        StateHasChanged();
    }

    private async Task CargarSolicitudes()
    {
        cargando = true;
        try
        {
            if (estaAutenticado)
            {
                solicitudes = await SolicitudService.ObtenerTodasLasSolicitudesAsync();
            }
            else
            {
                solicitudes = new List<SolicitudDTO.Solicitud>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar solicitudes: {ex.Message}");
            solicitudes = null;
        }
        finally
        {
            cargando = false;
            StateHasChanged();
        }
    }

    private void VerDetalle(SolicitudDTO.Solicitud solicitud)
    {
        // Navegación al detalle. Ejemplo: /solicitudes/123
        Navigation.NavigateTo($"/solicitudes/{solicitud.Id}");
    }

    private void NavegarACrearSolicitud()
    {
        // Navegación a la página de creación
        Navigation.NavigateTo("/solicitudes/crear");
    }
}